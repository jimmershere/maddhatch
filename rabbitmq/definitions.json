{
  "users": [
    {
      "name": "app",
      "password": "app",
      "tags": [
        "administrator"
      ]
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "app",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "queues": [
    {
      "name": "orders.q",
      "vhost": "/",
      "durable": true,
      "arguments": {
        "x-dead-letter-exchange": "orders.dlx"
      }
    },
    {
      "name": "receipts.q",
      "vhost": "/",
      "durable": true
    },
    {
      "name": "invoices.q",
      "vhost": "/",
      "durable": true
    },
    {
      "name": "payments.q",
      "vhost": "/",
      "durable": true
    },
    {
      "name": "tax.q",
      "vhost": "/",
      "durable": true
    },
    {
      "name": "orders.dlq",
      "vhost": "/",
      "durable": true
    }
  ],
  "exchanges": [
    {
      "name": "orders.direct",
      "vhost": "/",
      "type": "direct",
      "durable": true,
      "auto_delete": false
    },
    {
      "name": "orders.dlx",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false
    }
  ],
  "bindings": [
    {
      "source": "orders.direct",
      "vhost": "/",
      "destination": "orders.q",
      "destination_type": "queue",
      "routing_key": "order.created"
    },
    {
      "source": "orders.direct",
      "vhost": "/",
      "destination": "receipts.q",
      "destination_type": "queue",
      "routing_key": "receipt.request"
    },
    {
      "source": "orders.direct",
      "vhost": "/",
      "destination": "invoices.q",
      "destination_type": "queue",
      "routing_key": "invoice.request"
    },
    {
      "source": "orders.direct",
      "vhost": "/",
      "destination": "payments.q",
      "destination_type": "queue",
      "routing_key": "cashapp.request"
    },
    {
      "source": "orders.direct",
      "vhost": "/",
      "destination": "tax.q",
      "destination_type": "queue",
      "routing_key": "tax.report"
    },
    {
      "source": "orders.dlx",
      "vhost": "/",
      "destination": "orders.dlq",
      "destination_type": "queue",
      "routing_key": ""
    }
  ]
}