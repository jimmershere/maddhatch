# MaddHatchery.com runtime configuration.
# On the droplet these live in /home/<user>/.openclaw/secrets/stripe.env (sourced by start.sh).
# NEVER commit real values. This file documents the variable names only.

# Public site URL (used to build Stripe success/cancel return URLs).
SITE_URL=https://maddhatchery.com

# Port the Node service listens on (nginx reverse-proxies to this).
PORT=3200

# Stripe (LIVE keys = real charges). Hosted Checkout needs only the secret key.
STRIPE_SECRET_KEY=sk_live_or_test_xxx
# Webhook signing secret from the Stripe dashboard endpoint for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Flat shipping rate applied when a cart contains any shippable item (US cents).
SHIP_FLAT_CENTS=800

# Protects /admin (inventory). Send as ?token= or X-Admin-Token header.
ADMIN_TOKEN=choose-a-long-random-string

# Contact address surfaced in the UI and order notifications.
CONTACT_EMAIL=maddhatchery@gmail.com
