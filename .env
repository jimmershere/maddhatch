# Core service wiring
DATABASE_URL=postgres://postgres:postgres@db:5432/maddhatchery?sslmode=disable
AMQP_URL=amqp://app:app@rabbitmq:5672/
RMQ_EXCHANGE=orders.direct
MADDH_SHARED_SECRET=super-secret-token
MADDH_API_URL=http://api:8000

# OAuth2 / proxy integration
MADDH_OAUTH2_PROXY_URL=http://rbac:4180/oauth2
MADDH_OAUTH2_PROXY_INTERNAL_URL=
MADDH_OAUTH2_PROXY_INSECURE_SKIP_VERIFY=false
MADDH_OAUTH2_START=/oauth2/start

# Bootstrap identity
MADDH_BOOTSTRAP_ADMIN_USER=admin
MADDH_BOOTSTRAP_ADMIN_HASH=pbkdf2_sha256$180000$n04XKKmoufacaPJx1ODKUg==$SxWQMn9fMgmvVWHJGp9uVe2aQ5FspwLqjFK1xmTPZpI=
RBAC_SESSION_SECRET=rbac-session-secret
RBAC_COOKIE_SECURE=true

# LDAP
MADDH_LDAP_ENABLED=true
MADDH_LDAP_HOST=ldap
MADDH_LDAP_PORT=389
MADDH_LDAP_TLS=true
MADDH_LDAP_BIND_DN=cn=admin,dc=example,dc=com
MADDH_LDAP_BIND_PASSWORD=3wm078uu
MADDH_LDAP_BASE_DN=dc=example,dc=com
MADDH_LDAP_BOOTSTRAP_PASSWORD=3wm078uu
LDAP_HOST_PORT=389
LDAP_TLS_CA_FILE=/certs/fullchain.pem
LDAP_TLS_CERT_FILE=/certs/fullchain.pem
LDAP_TLS_KEY_FILE=/certs/privkey.pem
LDAP_TLS_CRT_FILENAME=fullchain.pem
LDAP_TLS_KEY_FILENAME=privkey.pem
LDAP_TLS_CA_CRT_FILENAME=fullchain.pem

# Optional RBAC overrides
RBAC_COOKIE_DOMAIN=
