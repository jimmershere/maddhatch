[Unit]
Description=Madd Hatchery Frontend
[Container]
# Build first: podman build -t localhost/maddhatchery-frontend:latest ./frontend_go
Image=localhost/maddhatchery-frontend:latest
Network=host
Volume=%h/maddhatchery/config/certs:/certs:ro
Env=AMQP_URL=amqp://guest:guest@localhost:5672/
Env=DATABASE_URL=postgres://postgres:postgres@localhost:5432/maddhatchery?sslmode=disable
Env=RMQ_EXCHANGE=orders.direct
[Install]
WantedBy=default.target
